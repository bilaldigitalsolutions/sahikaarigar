# ============================================
# Web - Sentry + Analytics (Firebase Hosting free plan)
# ============================================

# Sentry DSN - Sentry dashboard, Project Settings, Client Keys (DSN)
# Leave empty: Sentry stays disabled (no-op, zero bundle cost)
NEXT_PUBLIC_SENTRY_DSN=

# Analytics collector endpoint (PostHog / Segment / custom API)
NEXT_PUBLIC_ANALYTICS_ENDPOINT=

# Base URL for app metadata and absolute links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (already configured)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
