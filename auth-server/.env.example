# =============================================================================
# SahiKaarigar auth-server — environment
# Copy this file to `.env` and fill it in.  NEVER commit `.env`.
# =============================================================================

PORT=4000

# --- Public URLs (no trailing slash) -----------------------------------------
# Where THIS server is reachable. SuperTokens uses it for CORS + cookies.
API_DOMAIN=http://localhost:4000
# The static site origin. In production: https://sahi-kaarigar.web.app
WEBSITE_DOMAIN=http://localhost:3000

# Extra browser origins to allow (comma-separated). Localhost / 127.0.0.1 /
# 10.0.2.2 origins are always allowed, and native apps (no Origin header) always
# work. Add e.g. http://localhost:8081 here if you test with Expo web.
EXTRA_CORS_ORIGINS=
# Path SuperTokens serves its endpoints under (must match the frontend SDK).
API_BASE_PATH=/auth

# --- SuperTokens Core --------------------------------------------------------
# Option A — SuperTokens Cloud (easiest: free under 5,000 monthly active users)
#   SUPERTOKENS_CONNECTION_URI=https://<your-instance>.supertokens.io
#   SUPERTOKENS_API_KEY=<key from the SuperTokens dashboard>
# Option B — self-host with docker-compose.yml (this repo)
#   SUPERTOKENS_CONNECTION_URI=http://localhost:3567
#   SUPERTOKENS_API_KEY=<any long random string; give the Core the same value>
SUPERTOKENS_CONNECTION_URI=http://localhost:3567
SUPERTOKENS_API_KEY=

# --- Supabase (service_role key — SERVER ONLY, never expose to a browser) -----
SUPABASE_URL=https://gkrgyurjifxtbfffslzys.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Start-work OTP secret (REQUIRED) -----------------------------------------
# HMAC secret that derives the 4-digit "start work" OTP. The server REFUSES to
# boot without one — there is no default fallback anymore, because a secret
# baked into source would let anyone with repo access compute the codes.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Production (Render): set a unique random 32+ char value in Environment.
# This sample value is for LOCAL dev only.
OTP_SECRET=local-dev-secret-change-me-before-production

# --- SMS provider ------------------------------------------------------------
# One of: console | startmessaging | msg91 | fast2sms | messagecentral | twilio
# "console" prints the OTP to the server log — no account, no card, no cost.
# Perfect for development.
SMS_PROVIDER=console

# Message template (used by providers that send free text, e.g. Twilio)
APP_NAME=SahiKaarigar

# msg91 — https://msg91.com            (India, needs DLT registration)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# fast2sms — https://fast2sms.com   (India, UPI, no card)
#   Route A (/dev/otp/send) — cheapest, ~Rs.0.25/SMS. Set FAST2SMS_OTP_TEMPLATE_ID
#     to a "Smart OTP" template id from the dashboard. An SMS-channel template
#     REQUIRES DLT registration (TRAI); a WhatsApp-channel template does NOT.
#   Route B (/dev/bulkV2 route=q) — "Quick SMS": DLT-free, sends our whole message
#     text, random sender id, ~Rs.5/SMS, needs a one-time Rs.100 top-up.
FAST2SMS_API_KEY=
FAST2SMS_OTP_TEMPLATE_ID=

# startmessaging — https://startmessaging.com  (India, DLT-FREE, ~Rs.0.25/OTP)
#   The DLT-free SMS OTP provider here that accepts OUR otp value (variables.otp).
#   Sign up with email + one-time KYC, top up via UPI, create an API key
#   ("sm_live_..."). No DLT entity, sender ID or template approval needed.
STARTMESSAGING_API_KEY=
STARTMESSAGING_TEMPLATE_ID=

# --- Admin (worker approval) --------------------------------------------------
# Comma-separated phone numbers that may open /admin and approve/reject workers.
# A user whose `role` is 'admin' is always allowed too. Without this, nobody can
# approve workers — and unapproved workers never appear in search.
ADMIN_PHONES=

# Web admin panel login (sahiadmin). ADMIN_EMAIL also receives the
# "New Kaarigar Registered" alert — see the email section below.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Random 32+ char string used to sign the admin session cookie.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
# Origin(s) of the deployed admin panel, comma-separated, no trailing slash.
# REQUIRED when the panel is hosted separately from this API (e.g. Vercel),
# otherwise the browser blocks every /admin/* call → "Failed to fetch".
# Example: https://sahikaarigar.vercel.app
ADMIN_PANEL_ORIGINS=
# Cookie SameSite policy. Leave unset for the split Vercel→Render deployment
# (defaults to "none", which is required for cross-site cookies).
# Use "strict" or "lax" only when the panel and this API share a site.
ADMIN_COOKIE_SAMESITE=

# --- Transactional email (new-worker alerts) ----------------------------------
# The alert is sent to ADMIN_EMAIL (above). Sender defaults to EMAIL_FROM, then
# SMTP_USER. `sendEmail()` never throws — a broken provider can never fail a
# worker's registration; it is logged instead.
#
# Option A — Resend (recommended on Render; no npm package, HTTP API):
#   RESEND_API_KEY=re_xxxxxxxx
#   EMAIL_FROM=SahiKaarigar <alerts@your-verified-domain.com>
#   Note: Resend only lets you send from a verified domain, or from
#   onboarding@resend.dev to the account owner's own address.
#
# Option B — SMTP via nodemailer (npm install nodemailer):
#   Gmail needs an App Password (Google Account → Security → 2-Step → App
#   passwords), NOT your normal password.
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your.address@gmail.com
#   SMTP_PASS=the-16-character-app-password
#
# With neither configured, the email is printed to the server log (dev only).
RESEND_API_KEY=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# messagecentral / VerifyNow — https://messagecentral.com
# DLT-free managed OTP (about ₹0.30 per OTP)
MESSAGECENTRAL_CUSTOMER_ID=
MESSAGECENTRAL_PASSWORD=
MESSAGECENTRAL_BASE_URL=https://cpaas.messagecentral.com

# twilio — https://twilio.com          (global, requires a card)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
