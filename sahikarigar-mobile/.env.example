# =============================================================================
# SahiKaarigar Mobile — environment variables
# =============================================================================
# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
#
# Expo only exposes variables that start with EXPO_PUBLIC_ to the app bundle,
# so nothing secret belongs here.
# =============================================================================

# The SuperTokens auth-server (Render / localhost:4000).
#   Local dev (Android emulator): http://10.0.2.2:4000
#   Local dev (physical device):  http://<your-lan-ip>:4000
#   Production:                   https://sahikaarigar-auth.onrender.com
#   Local web dev (Expo web):     http://localhost:4000  (run the auth-server locally)
EXPO_PUBLIC_AUTH_API_URL=https://sahikaarigar-auth.onrender.com

# NOTE (web only): browsers enforce CORS. To test in a browser, the auth-server
# must allow your origin — set WEBSITE_DOMAIN (and/or EXTRA_CORS_ORIGINS) on the
# server. The Android app is unaffected by CORS.

# Shown in the UI / used by the SuperTokens client.
EXPO_PUBLIC_APP_NAME=Sahi Kaarigar

# Supabase project (only needed if you talk to Supabase directly from the app).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Set to "1" to run the app with bundled sample data and NO backend.
# 0 (default) = 100% real: real API, real errors, real OTP. Leave it at 0 for
# production. Use 1 only to demo the UI offline.
EXPO_PUBLIC_DEMO_MODE=0

# --- Area / location picker -------------------------------------------------
# Ola Maps — primary provider. Get an API key from Krutrim Cloud:
#   https://cloud.olakrutrim.com
#   Docs: https://maps.olakrutrim.com/docs
# NOTE: this is a build-time EXPO_PUBLIC_* value, so it is embedded in the app
# bundle. Restrict the key in the Ola Maps console. Release builds also need it
# in the CI workflow / EAS env — a local .env alone is not enough.
EXPO_PUBLIC_OLA_MAPS_API_KEY=
# 1 = print Ola Maps request/response diagnostics (dev builds already log).
# Leave 0 for public release builds: responses include the user's location query.
EXPO_PUBLIC_OLA_MAPS_DEBUG=0

# Google Places API key (optional secondary provider).
# Without Ola Maps/Google, the picker falls back to Photon then the built-in
# Hyderabad area list.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Observability (Sentry crash reporting + analytics) ---------------------
# Optional. When EMPTY, every crash/analytics call is a silent no-op — the app
# works exactly as before with zero extra setup.
#
# Sentry DSN (sentry.io > your project > Settings > Client Keys (DSN)).
# Catches unhandled JS + native errors, API failures and breadcrumbs.
EXPO_PUBLIC_SENTRY_DSN=

# Analytics collector endpoint that accepts POST {event, properties, ts} JSON.
# Point it at PostHog's https://<host>/capture (send `api_key` in properties)
# or any custom collector. Events tracked: user_signup, worker_registered,
# hire_created, hire_accepted, hire_completed, feedback_submitted,
# search_performed.
EXPO_PUBLIC_ANALYTICS_ENDPOINT=

# PostHog project API key + ingestion host. The host must match the project's
# region: https://eu.i.posthog.com (EU Cloud) or https://us.i.posthog.com (US).
# When either is empty, all PostHog tracking is a silent no-op.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
